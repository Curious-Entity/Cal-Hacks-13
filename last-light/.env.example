# TEMPLATE ONLY. Put real keys in last-light/.env, never in this file.
# .env is ignored by Git and read only by the local server.
GEMINI_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Text provider: cloudflare or gemini. If omitted, existing Gemini keys take
# priority; otherwise Cloudflare credentials enable stories without Gemini.
# Set TEXT_PROVIDER=cloudflare to use Cloudflare when both keys are present.
# TEXT_PROVIDER=cloudflare
# CLOUDFLARE_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Optional Gemini narrative model override:
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Image provider: cloudflare, openai, or gemini. Keys stay on the server.
IMAGE_PROVIDER=cloudflare
ENABLE_IMAGE_GENERATION=true
# Budget preset: one low-quality 1024x1024 image per explicit request.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Image references increase input usage; off unless explicitly enabled.
OPENAI_IMAGE_USE_REFERENCE=false
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional stable signing secret:
# STORY_SESSION_SECRET=
