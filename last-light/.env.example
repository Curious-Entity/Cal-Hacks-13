# Copy this file to .env, then add your own Gemini API key.
# .env is ignored by Git. Never put a key in browser JavaScript.
GEMINI_API_KEY=AQ.Ab8RN6KJXClYok1lNz0y-Y4RnjbhJmvwqWgpW0MJ1XCRXOwn1w
# Optional model overrides; defaults are set in backend/gemini.js.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# AI bitmap illustrations require image-model access. Atmospheric vector scenes
# work on the text-only path. Enable bitmap images only if you want to use them.
ENABLE_IMAGE_GENERATION=false
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional stable signing secret if you expect to rotate the Gemini key:
# STORY_SESSION_SECRET=
